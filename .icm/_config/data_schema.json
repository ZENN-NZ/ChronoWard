{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronoWard Data Models",
  "definitions": {
    "TaskRow": {
      "type": "object",
      "required": ["timerId", "task", "hours"],
      "properties": {
        "timerId": { "type": "string" },
        "task": { "type": "string" },
        "hours": { "type": "number", "minimum": 0, "maximum": 24 },
        "ot": { "type": "boolean" },
        "ticketNum": {
          "type": "string",
          "pattern": "^.{0,12}[0-9]{0,12}$"
        },
        "description": { "type": "string" }
      }
    },
    "SheetDay": {
      "type": "array",
      "items": { "$ref": "#/definitions/TaskRow" }
    },
    "SheetsStore": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": { "$ref": "#/definitions/SheetDay" }
      }
    },
    "TimerItem": {
      "type": "object",
      "required": ["elapsed", "running"],
      "properties": {
        "elapsed": { "type": "integer", "minimum": 0 },
        "running": { "type": "boolean" },
        "startedAt": { "type": ["integer", "null"] }
      }
    },
    "TimersStore": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/TimerItem" }
    },
    "Settings": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "themeBaseOffset": { "type": "integer", "minimum": 0 },
        "autoRotateTheme": { "type": "boolean" },
        "hourIncrement": { "type": "number", "minimum": 0.01 },
        "projectMode": { "type": "boolean" },
        "detailedMode": { "type": "boolean" },
        "focusTimes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "overlayPosition": {
          "type": "string",
          "enum": ["top-right", "top-left", "bottom-right", "bottom-left", "center-left", "center-right"]
        },
        "installedAt": { "type": "integer" },
        "warningTime": { "type": "string" },
        "minHoursWarning": { "type": "number", "minimum": 0, "maximum": 24 },
        "autoStart": { "type": "boolean" }
      }
    }
  }
}
