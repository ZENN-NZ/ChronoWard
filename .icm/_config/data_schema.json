{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronoWard Data Models",
  "definitions": {
    "TaskRow": {
      "type": "object",
      "required": ["timerId", "task", "hours"],
      "properties": {
        "timerId": { "type": "string" },
        "task": { "type": "string" },
        "hours": { "type": "number", "minimum": 0 },
        "ot": { "type": "boolean" },
        "ticketNum": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{0,24}$"
        },
        "description": { "type": "string" }
      }
    },
    "SheetDay": {
      "type": "array",
      "items": { "$ref": "#/definitions/TaskRow" }
    },
    "SheetsStore": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": { "$ref": "#/definitions/SheetDay" }
      }
    },
    "TimerItem": {
      "type": "object",
      "required": ["elapsed", "running"],
      "properties": {
        "elapsed": { "type": "integer", "minimum": 0 },
        "running": { "type": "boolean" },
        "startedAt": { "type": ["integer", "null"] }
      }
    },
    "TimersStore": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/TimerItem" }
    },
    "Settings": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "themeBaseOffset": { "type": "integer", "minimum": 0 },
        "autoRotateTheme": { "type": "boolean" },
        "hourIncrement": { "type": "number", "minimum": 0.01 },
        "overlayPosition": {
          "type": "string",
          "enum": ["top-right", "top-left", "bottom-right", "bottom-left", "center-left", "center-right"]
        },
        "installedAt": { "type": "integer" },
        "themeSetAt": { "type": "integer" },
        "warningTime": { "type": "string" },
        "minHoursWarning": { "type": "number" },
        "auto_start": { "type": "boolean" }
      }
    }
  }
}
